{
  "name": "business-intelligence-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm run db:generate",
    "sync:worker": "npx tsx scripts/sync-worker.ts",
    "seed:admin": "npx tsx scripts/seed-admin.ts",
    "db:generate": "npx prisma generate --schema=prisma/zoho.prisma && npx prisma generate --schema=prisma/visit.prisma",
    "db:push": "npx prisma db push --schema=prisma/zoho.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.66.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
